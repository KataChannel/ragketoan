# =============================================================================
# RAG Service Configuration
# =============================================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# PostgreSQL Database (same as ketoan app)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/n8n

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=ketoan_invoices

# =============================================================================
# LLM Provider: Choose 'ollama' (local) or 'google' (Google AI Studio cloud)
# =============================================================================
LLM_PROVIDER=ollama

# Ollama LLM (Local - Default)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:latest

# Google AI Studio (Cloud - Optional)
# Get API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Model options:
# - gemini-1.5-flash (fast, good for most tasks)
# - gemini-1.5-pro (best quality, slower)
# - gemini-2.0-flash-exp (experimental, newest features)
GOOGLE_MODEL=gemini-1.5-flash

# Embedding Model
# Options: 
# - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (multilingual, recommended)
# - sentence-transformers/all-MiniLM-L6-v2 (English, faster)
# - intfloat/multilingual-e5-small (multilingual, good for Vietnamese)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# RAG Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
